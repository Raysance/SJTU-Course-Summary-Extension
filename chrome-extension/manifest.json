{
  "manifest_version": 3,
  "name": "SJTU 课程资料助手",
  "version": "4.9.3",
  "minimum_chrome_version": "116",
  "description": "读取 SJTU 课堂字幕、打包课程文件，并在本地轻量监测直播二维码，及时提醒。",
  "permissions": ["downloads", "storage", "tabs", "scripting", "webRequest", "notifications", "offscreen"],
  "host_permissions": [
    "https://oc.sjtu.edu.cn/*",
    "https://s3.jcloud.sjtu.edu.cn/*",
    "https://v.sjtu.edu.cn/jy-application-resourcemanage-ui/*",
    "https://api.deepseek.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_title": "打开 SJTU 课程资料助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://v.sjtu.edu.cn/jy-application-resourcemanage-ui/*", "https://oc.sjtu.edu.cn/courses/*"],
      "js": ["vendor/jsQR.js", "qr-core.js", "qr-content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://v.sjtu.edu.cn/jy-application-resourcemanage-ui/*"
      ],
      "js": ["video-platform.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://oc.sjtu.edu.cn/courses/*/files*"
      ],
      "js": ["files-content.js"],
      "run_at": "document_idle"
    }
  ]
}
